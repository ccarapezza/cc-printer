[Unit]
Description=Cloudflare Tunnel 'impresora' (impresora.cc-lab.space -> nginx 127.0.0.1:8081)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
EnvironmentFile=/etc/cloudflared/impresora.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
DynamicUser=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
