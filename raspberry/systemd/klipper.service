[Unit]
Description=Klipper 3D Printer Firmware
Documentation=https://www.klipper3d.org/
After=network-online.target
Wants=udev.target

[Install]
WantedBy=multi-user.target

[Service]
Type=simple
User=chori
RemainAfterExit=yes
WorkingDirectory=/home/chori/klipper
EnvironmentFile=/home/chori/printer_data/systemd/klipper.env
ExecStart=/home/chori/klippy-env/bin/python $KLIPPER_ARGS
Restart=always
RestartSec=10
